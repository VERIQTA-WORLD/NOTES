{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Veriqta: on-demand task tracking table",
  "Resources": {
    "Tasks": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "AttributeDefinitions": [
          {
            "AttributeName": "taskId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "taskId",
            "KeyType": "HASH"
          }
        ],
        "BillingMode": "PAY_PER_REQUEST",
        "Tags": [
          {
            "Key": "Project",
            "Value": "Veriqta"
          },
          {
            "Key": "Environment",
            "Value": "Practice"
          }
        ]
      }
    }
  },
  "Outputs": {
    "TableName": {
      "Value": {
        "Ref": "Tasks"
      }
    },
    "TableArn": {
      "Value": {
        "Fn::GetAtt": [
          "Tasks",
          "Arn"
        ]
      }
    }
  }
}
