{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Veriqta: private image registry",
  "Resources": {
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Veriqta"
          },
          {
            "Key": "Environment",
            "Value": "Practice"
          }
        ]
      }
    }
  },
  "Outputs": {
    "RepositoryName": {
      "Value": {
        "Ref": "Repository"
      }
    },
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "RepositoryArn": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "Arn"
        ]
      }
    }
  }
}
