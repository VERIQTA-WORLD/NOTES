{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Veriqta: repository/branch scoped GitHub OIDC deployment identity",
  "Parameters": {
    "GitHubRepository": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"
    },
    "SiteBucketName": {
      "Type": "String"
    },
    "DistributionId": {
      "Type": "String"
    },
    "ExistingProviderArn": {
      "Type": "String",
      "Default": ""
    }
  },
  "Conditions": {
    "CreateProvider": {
      "Fn::Equals": [
        {
          "Ref": "ExistingProviderArn"
        },
        ""
      ]
    }
  },
  "Resources": {
    "Provider": {
      "Type": "AWS::IAM::OIDCProvider",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Veriqta"
          },
          {
            "Key": "Environment",
            "Value": "Practice"
          }
        ]
      },
      "Condition": "CreateProvider"
    },
    "DeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateProvider",
                    {
                      "Ref": "Provider"
                    },
                    {
                      "Ref": "ExistingProviderArn"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubRepository}:ref:refs/heads/main"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "VeriqtaWebsiteDeployment",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucketName}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SiteBucketName}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront:CreateInvalidation",
                    "cloudfront:GetInvalidation",
                    "cloudfront:GetDistribution"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${DistributionId}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeployRole",
          "Arn"
        ]
      }
    }
  }
}
