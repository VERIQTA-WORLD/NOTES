{
  "title": "Veriqta API investigation",
  "uid": "veriqta-ai-ops",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "veriqta:error_ratio:5m"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 4,
      "title": "Process CPU cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total[5m])"
        }
      ]
    },
    {
      "id": 5,
      "title": "Resident memory bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes"
        }
      ]
    },
    {
      "id": 6,
      "title": "Business response counts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status)(increase(http_requests_total[5m]))"
        }
      ]
    }
  ]
}
