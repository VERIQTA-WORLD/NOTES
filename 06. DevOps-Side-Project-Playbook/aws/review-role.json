{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Veriqta read-only drift and cost investigation role",
  "Parameters": {
    "Repository": {
      "Type": "String",
      "AllowedPattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"
    },
    "Branch": {
      "Type": "String",
      "Default": "main"
    },
    "OidcProviderArn": {
      "Type": "String"
    },
    "StateBucket": {
      "Type": "String"
    }
  },
  "Resources": {
    "ReviewRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "OidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${Repository}:ref:refs/heads/${Branch}"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "review",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:Describe*",
                    "ce:GetCostAndUsage"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${StateBucket}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${StateBucket}/drift/terraform.tfstate"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${StateBucket}/drift/terraform.tfstate.tflock"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ReviewRole",
          "Arn"
        ]
      }
    }
  }
}
