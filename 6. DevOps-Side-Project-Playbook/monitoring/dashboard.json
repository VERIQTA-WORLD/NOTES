{
  "title": "Veriqta service reliability",
  "uid": "veriqta-slo",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Availability (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - service:error_ratio:5m",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "30d request-weighted budget remaining",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "1 - ((sum(increase(http_requests_total{code=~\"5..\"}[30d])) or vector(0)) / sum(increase(http_requests_total[30d]))) / 0.001",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pool connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "db_pool_pool_size",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pool wait seconds cumulative",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veriqta-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "db_pool_requests_wait_ms / 1000",
          "refId": "A"
        }
      ]
    }
  ]
}
